{
  "name": "topic-kanban-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,pages \"pnpm dev:web\" \"pnpm dev:pages\"",
    "dev:web": "vite --port 3000",
    "dev:pages": "wrangler pages dev --proxy 3000 --port 8798 --persist-to .wrangler/state",
    "db:init:local": "wrangler d1 execute DB --local --file=./drizzle/0000_schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file=./drizzle/0000_schema.sql",
    "db:upgrade:published:local": "wrangler d1 execute DB --local --file=./drizzle/0001_optional_published_topic.sql",
    "db:upgrade:published:remote": "wrangler d1 execute DB --remote --file=./drizzle/0001_optional_published_topic.sql",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-character-count": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "hono": "^4.7.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
