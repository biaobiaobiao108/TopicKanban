{
  "name": "topic-kanban-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "vite --port 3030",
    "dev:server": "PORT=8787 bun --watch src/server/server.ts",
    "build": "tsc && vite build && bun run build:server",
    "build:server": "NODE_ENV=production bun build src/server/server.ts --target=bun --format=esm --outfile=dist/server.js",
    "start": "bun dist/server.js",
    "preview": "vite preview",
    "check:bundle": "bun scripts/checkBundleSize.ts",
    "test": "bun test",
    "test:run": "bun test",
    "test:e2e": "bun run --bun playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-character-count": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.39.0",
    "opencc-js": "1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bun-types": "^1.4.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.1.0"
  },
  "workspaces": ["."]
}
