{
  "name": "topic-kanban-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "vite --port 3000",
    "dev:server": "PORT=8787 bun --watch src/server/server.ts",
    "dev:pages": "wrangler pages dev --proxy 3000 --port 8798 --persist-to .wrangler/state",
    "db:init:local": "wrangler d1 execute DB --local --file=./drizzle/0000_schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file=./drizzle/0000_schema.sql",
    "db:upgrade:published:local": "wrangler d1 execute DB --local --file=./drizzle/0001_optional_published_topic.sql",
    "db:upgrade:published:remote": "wrangler d1 execute DB --remote --file=./drizzle/0001_optional_published_topic.sql",
    "db:upgrade:source-type:local": "wrangler d1 execute DB --local --file=./drizzle/0003_remove_source_type.sql",
    "db:upgrade:source-type:remote": "wrangler d1 execute DB --remote --file=./drizzle/0003_remove_source_type.sql",
    "db:upgrade:settings:local": "wrangler d1 execute DB --local --file=./drizzle/0004_remove_settings_table.sql",
    "db:upgrade:settings:remote": "wrangler d1 execute DB --remote --file=./drizzle/0004_remove_settings_table.sql",
    "db:upgrade:publish-package:local": "wrangler d1 execute DB --local --file=./drizzle/0005_create_publish_packages.sql",
    "db:upgrade:publish-package:remote": "wrangler d1 execute DB --remote --file=./drizzle/0005_create_publish_packages.sql",
    "build": "tsc && vite build && bun run build:server",
    "build:server": "bun build src/server/server.ts --target=bun --format=esm --outfile=dist/server.js",
    "start": "bun dist/server.js",
    "preview": "vite preview",
    "test": "bun test",
    "test:run": "bun test",
    "test:e2e": "bun run --bun playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-character-count": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "hono": "^4.7.1",
    "lucide-react": "^1.16.0",
    "opencc-js": "1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@playwright/test": "^1.62.1",
    "bun-types": "^1.4.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.125.0"
  },
  "workspaces": ["."]
}
