{
  "name": "topic-kanban-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun run --bun vite --port 3030",
    "dev:server": "bun --watch src/server/server.ts",
    "build": "bun run --bun tsc && bun run --bun vite build && bun run build:server",
    "build:server": "NODE_ENV=production bun build src/server/server.ts --target=bun --format=esm --outfile=dist/server.js",
    "start": "NODE_ENV=production bun dist/server.js",
    "preview": "bun run --bun vite preview",
    "check:bundle": "bun scripts/checkBundleSize.ts",
    "test": "bun test",
    "test:run": "bun test",
    "test:e2e": "bun run --bun playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-character-count": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.39.0",
    "opencc-js": "1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "bun-types": "^1.4.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "workspaces": ["."]
}
