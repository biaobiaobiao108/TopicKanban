# =======================================================
# 🎬 选题生产工作台 (Topic Kanban Studio) 环境变量配置模板
# =======================================================

# 工作台访问密码 (本地开发默认 admin，生产部署请务必修改为高强度密码)
APP_PASSWORD=admin

# 手机快捷指令灵感快投 Token (可选，配置后快捷指令可免登录直投)
QUICK_DROP_TOKEN=dev_drop_token

# 反向代理公网域名 (例如 https://kanban.yourdomain.com，本地局域网调试可留空)
PUBLIC_BASE_URL=

# 本地 SQLite 数据保存目录 (容器部署默认为 /app/data，本地开发默认为 ./data)
DATA_DIR=./data

# 服务端口 (容器部署与生产默认 3000，开发模式后端默认 8787，前端 Vite 默认 3000)
PORT=8787
