# =======================================================
# 🐾 喵爪看板 (MiaoZhua Kanban) 环境变量配置模板
# =======================================================

# 工作台访问密码。此值仅为可执行占位符，部署前必须替换为唯一的长随机密码。
APP_PASSWORD=replace-this-with-a-unique-random-password-before-deployment

# 手机快捷指令灵感快投 Token (可选；启用免登录快投时设置独立的随机 Token)
QUICK_DROP_TOKEN=

# 反向代理公网域名 (例如 https://kanban.yourdomain.com，本地局域网调试可留空)
PUBLIC_BASE_URL=

# 本地 SQLite 数据保存目录 (容器部署默认为 /app/data，本地开发默认为 ./data)
DATA_DIR=./data

# 服务端口 (本地开发、容器部署与生产默认 3030)
PORT=3030
